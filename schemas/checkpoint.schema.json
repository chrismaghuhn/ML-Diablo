{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dxai/checkpoint.schema.json",
  "title": "DXAI checkpoint manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "learner_step", "model_class",
    "observation_version", "action_version", "task_ids", "upstream_revision",
    "config_sha256", "weights_sha256", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "dxai.checkpoint.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "learner_step": {"type": "integer", "minimum": 0},
    "model_class": {"type": "string", "minLength": 1},
    "observation_version": {"type": "string", "minLength": 1},
    "action_version": {"type": "string", "minLength": 1},
    "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "upstream_revision": {"type": "string", "minLength": 7},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "weights_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
  }
}
